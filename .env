POSTGRES_USER=nqa
POSTGRES_PASSWORD=nqa_password
POSTGRES_DB=nqa

DATA_ROOT=/data
SOLVER_URL=http://solver:8081
OPTUNA_DASHBOARD_BIND_HOST=0.0.0.0
OPTUNA_DASHBOARD_PORT=8001
NQA_MASTER_SCRIPT=/nqa/nqa/master.py

# Default HPO settings for the API service
HPO_DEFAULT_NUM_TRIALS=100
HPO_DEFAULT_NUM_WORKERS=1
HPO_DEFAULT_TRIAL_MAX_RUNTIME=1800
HPO_DEFAULT_VQA_NUM_ANNEALING_STEPS_MIN=1000
HPO_DEFAULT_VQA_NUM_ANNEALING_STEPS_MAX=10000
HPO_DEFAULT_VQA_NUM_UPDATES_PER_STEP_MIN=1
HPO_DEFAULT_VQA_NUM_UPDATES_PER_STEP_MAX=3
HPO_DEFAULT_VQA_ANNEALING_FIELD_SCALE_MIN=0.1
HPO_DEFAULT_VQA_ANNEALING_FIELD_SCALE_MAX=10
HPO_DEFAULT_VQA_CATALYST_FIELD_SCALE_MIN=0.1
HPO_DEFAULT_VQA_CATALYST_FIELD_SCALE_MAX=10
HPO_DEFAULT_SGD_LEARNING_RATE_MIN=0.01
HPO_DEFAULT_SGD_LEARNING_RATE_MAX=1
HPO_DEFAULT_SGD_MOMENTUM_MIN=0.0
HPO_DEFAULT_SGD_MOMENTUM_MAX=0.9
HPO_DEFAULT_SR_DIAGONAL_SHIFT_MIN=1e-7
HPO_DEFAULT_SR_DIAGONAL_SHIFT_MAX=0.1
HPO_DEFAULT_DBQS_NUM_HIDDEN_LAYERS=2
HPO_DEFAULT_DBQS_UNIT_DENSITY_PER_LAYER_MIN=0.5
HPO_DEFAULT_DBQS_UNIT_DENSITY_PER_LAYER_MAX=2.0
HPO_DEFAULT_MCMC_NUM_SAMPLES_MIN=8
HPO_DEFAULT_MCMC_NUM_SAMPLES_MAX=128
HPO_DEFAULT_MCMC_NUM_SWEEP_STEPS_MIN=4
HPO_DEFAULT_MCMC_NUM_SWEEP_STEPS_MAX=32
